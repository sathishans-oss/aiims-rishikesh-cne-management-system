{
  "name": "aiims-rishikesh-cne-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "worker:dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply cne_d1_prod --local",
    "d1:migrate:remote": "wrangler d1 migrations apply cne_d1_prod --remote",
    "clean": "rm -rf dist",
    "audit": "node scripts/project-audit.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.40.0",
    "@types/sql.js": "^1.4.11"
  }
}
